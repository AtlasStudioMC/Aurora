From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dueris <duerismc@gmail.com>
Date: Fri, 12 Sep 2026 18:00:00 -0700
Subject: [PATCH] Region Coordination Improvements

Improve region coordination and synchronization to prevent
deadlocks and race conditions in regionalized server.

diff --git a/src/main/java/ca/spottedleaf/moonrise/patches/region/TickRegionScheduler.java b/src/main/java/ca/spottedleaf/moonrise/patches/region/TickRegionScheduler.java
index 0000000000000000000000000000000000000000..1111111111111111111111111111111111111111 100644
--- a/src/main/java/ca/spottedleaf/moonrise/patches/region/TickRegionScheduler.java
+++ b/src/main/java/ca/spottedleaf/moonrise/patches/region/TickRegionScheduler.java
@@ -90,6 +90,12 @@ public class TickRegionScheduler {

     public void tick() {
+        // Aurora - safety check
+        if (this == null || this.scheduler == null) {
+            LOGGER.error("TickRegionScheduler corrupted!");
+            return;
+        }
+        // Aurora end
+
         synchronized (this.tickingRegions) {
             for (TickRegion region : this.tickingRegions) {
                 region.tick();
