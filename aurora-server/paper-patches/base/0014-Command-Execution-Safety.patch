From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dueris <duerismc@gmail.com>
Date: Fri, 12 Sep 2026 15:00:00 -0700
Subject: [PATCH] Command Execution Safety

Add safety checks for command execution to prevent crashes from
concurrent command processing or invalid contexts.

diff --git a/src/main/java/net/minecraft/commands/CommandSourceStack.java b/src/main/java/net/minecraft/commands/CommandSourceStack.java
index 0000000000000000000000000000000000000000..1111111111111111111111111111111111111111 100644
--- a/src/main/java/net/minecraft/commands/CommandSourceStack.java
+++ b/src/main/java/net/minecraft/commands/CommandSourceStack.java
@@ -250,6 +250,11 @@ public class CommandSourceStack {
     public void sendSuccess(Component component, boolean broadcastToOps) {
         if (this.source instanceof ServerPlayer) {
             ServerPlayer serverplayer = (ServerPlayer)this.source;
+            // Aurora - safety check
+            if (serverplayer == null || serverplayer.isRemoved()) {
+                return;
+            }
+            // Aurora end
             serverplayer.displayClientMessage(component, false);
         }
     }
@@ -257,6 +262,11 @@ public class CommandSourceStack {
     @Override
     public void sendFailure(Component component) {
         if (this.source instanceof ServerPlayer) {
             ServerPlayer serverplayer = (ServerPlayer)this.source;
+            // Aurora - safety check
+            if (serverplayer == null || serverplayer.isRemoved()) {
+                return;
+            }
+            // Aurora end
             serverplayer.displayClientMessage(component, true);
         }
     }
