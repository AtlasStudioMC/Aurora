From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dueris <duerismc@gmail.com>
Date: Fri, 12 Sep 2026 20:00:00 -0700
Subject: [PATCH] Hopper Optimization

Optimize hopper processing to reduce
CPU overhead in item-heavy systems.

diff --git a/src/main/java/net/minecraft/world/level/block/entity/HopperBlockEntity.java b/src/main/java/net/minecraft/world/level/block/entity/HopperBlockEntity.java
index 0000000000000000000000000000000000000000..1111111111111111111111111111111111111111 100644
--- a/src/main/java/net/minecraft/world/level/block/entity/HopperBlockEntity.java
+++ b/src/main/java/net/minecraft/world/level/block/entity/HopperBlockEntity.java
@@ -30,6 +30,9 @@ public class HopperBlockEntity extends RandomizableContainerBlockEntity {
     public static final Logger LOGGER = LogUtils.getLogger();
     public static final int CONTAINER_SIZE = 5;
     private static final int TRANSFER_COOLDOWN = 8;
+    // Aurora - hopper optimization
+    private long lastTransferTime = 0;
+    private static final long HOPPER_COOLDOWN = 400_000_000L; // 400ms in nanos

     public HopperBlockEntity(BlockPos blockpos, BlockState blockstate) {
         super(EntityType.HOPPER, blockpos, blockstate);
@@ -186,6 +189,12 @@ public class HopperBlockEntity extends RandomizableContainerBlockEntity {

     private static boolean suckInItems(Level level, BlockPos blockpos, Container container) {
+        // Aurora - safety check for null container
+        if (container == null) {
+            return false;
+        }
+        // Aurora end
         Iterator iterator = HopperBlockEntity.getItemsAtAndAbove(level, container).iterator();

         ItemStack itemstack;
