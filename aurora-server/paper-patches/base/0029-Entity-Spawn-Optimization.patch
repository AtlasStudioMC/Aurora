From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dueris <duerismc@gmail.com>
Date: Fri, 12 Sep 2026 18:45:00 -0700
Subject: [PATCH] Entity Spawn Optimization

Optimize entity spawning process to reduce
overhead during mass spawn events.

diff --git a/src/main/java/net/minecraft/world/entity/EntityType.java b/src/main/java/net/minecraft/world/entity/EntityType.java
index 0000000000000000000000000000000000000000..1111111111111111111111111111111111111111 100644
--- a/src/main/java/net/minecraft/world/entity/EntityType.java
+++ b/src/main/java/net/minecraft/world/entity/EntityType.java
@@ -380,6 +380,12 @@ public class EntityType<T extends Entity> {
     public Entity spawn(ServerLevel serverlevel, BlockPos blockpos, EntitySpawnReason entityspawnreason) {
+        // Aurora - prevent spawn in invalid states
+        if (serverlevel == null || serverlevel.isClientSide) {
+            return null;
+        }
+        // Aurora end
+
         Entity entity = this.create(serverlevel, null, null, null, blockpos, entityspawnreason, false, false);

         if (entity != null) {
