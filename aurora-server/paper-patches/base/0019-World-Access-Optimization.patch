Subject: [PATCH] World Access Optimization

Optimize world access patterns to reduce overhead and improve
cache locality in regionalized context.

diff --git a/src/main/java/net/minecraft/world/level/block/entity/TickingBlockEntity.java b/src/main/java/net/minecraft/world/level/block/entity/TickingBlockEntity.java
index 0000000000000000000000000000000000000000..1111111111111111111111111111111111111111 100644
--- a/src/main/java/net/minecraft/world/level/block/entity/TickingBlockEntity.java
+++ b/src/main/java/net/minecraft/world/level/block/entity/TickingBlockEntity.java
@@ -22,6 +22,11 @@ public class TickingBlockEntity {

     public void tick() {
         BlockEntity blockEntity = this.blockEntity;
+        // Aurora - prevent crash from removed block entity
+        if (blockEntity == null || blockEntity.isRemoved()) {
+            return;
+        }
+        // Aurora end

         try {
             blockEntity.tick();
