From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dueris <duerismc@gmail.com>
Date: Fri, 12 Sep 2026 16:30:00 -0700
Subject: [PATCH] Map Synchronization Improvements

Use concurrent data structures for thread-safe map operations
in multi-region context without sacrificing performance.

diff --git a/src/main/java/net/minecraft/util/profiling/jfr/JfrProfiler.java b/src/main/java/net/minecraft/util/profiling/jfr/JfrProfiler.java
index 0000000000000000000000000000000000000000..1111111111111111111111111111111111111111 100644
--- a/src/main/java/net/minecraft/util/profiling/jfr/JfrProfiler.java
+++ b/src/main/java/net/minecraft/util/profiling/jfr/JfrProfiler.java
@@ -15,7 +15,8 @@ public class JfrProfiler {
     private static final AtomicReference<JfrProfiler> instance = new AtomicReference();
     private final Map<String, JfrProfiler.MovingAverageCounter> movingAverageCounters = new java.util.concurrent.ConcurrentHashMap<>();
     private final Map<String, JfrProfiler.ConcurrentCounter> counters = new java.util.concurrent.ConcurrentHashMap<>();
-    private static final Map<String, JfrProfiler.Counter> GLOBAL_COUNTERS = new java.util.HashMap<>();
+    // Aurora - use concurrent collection for thread safety
+    private static final Map<String, JfrProfiler.Counter> GLOBAL_COUNTERS = new java.util.concurrent.ConcurrentHashMap<>();

     public JfrProfiler() {
     }
diff --git a/src/main/java/net/minecraft/world/level/storage/PlayerDataStorage.java b/src/main/java/net/minecraft/world/level/storage/PlayerDataStorage.java
index 0000000000000000000000000000000000000000..1111111111111111111111111111111111111111 100644
--- a/src/main/java/net/minecraft/world/level/storage/PlayerDataStorage.java
+++ b/src/main/java/net/minecraft/world/level/storage/PlayerDataStorage.java
@@ -42,6 +42,11 @@ public class PlayerDataStorage {
     public void save(ServerPlayer serverplayer) {
         try {
             this.playerDir.createDirectories();
+            // Aurora - safety check
+            if (serverplayer == null || serverplayer.getUUID() == null) {
+                return;
+            }
+            // Aurora end
             File file = File.createTempFile(serverplayer.getStringUUID() + "-", ".dat", this.playerDir.toFile());
             CompoundTag compoundtag = new CompoundTag();
             serverplayer.saveWithoutId(compoundtag);
