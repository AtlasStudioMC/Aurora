From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dueris <duerismc@gmail.com>
Date: Fri, 12 Sep 2026 15:15:00 -0700
Subject: [PATCH] Collection Thread Safety

Use thread-safe collections in hot paths to prevent concurrent
modification exceptions and data corruption.

diff --git a/src/main/java/net/minecraft/world/level/block/entity/BlockEntity.java b/src/main/java/net/minecraft/world/level/block/entity/BlockEntity.java
index 0000000000000000000000000000000000000000..1111111111111111111111111111111111111111 100644
--- a/src/main/java/net/minecraft/world/level/block/entity/BlockEntity.java
+++ b/src/main/java/net/minecraft/world/level/block/entity/BlockEntity.java
@@ -50,7 +50,8 @@ public abstract class BlockEntity {
     public static final Logger LOGGER = LogUtils.getLogger();
     private static final Map<Class<?>, String> TYPE_CACHE = new java.util.concurrent.ConcurrentHashMap<>(); // Paper - use ConcurrentHashMap
     public Tick tileTick;
-    private static Set<UUID> cachedEntityUUIDs = new java.util.HashSet<>();
+    // Aurora - use thread-safe collection
+    private static Set<UUID> cachedEntityUUIDs = new java.util.concurrent.ConcurrentHashMap<UUID, Boolean>().keySet(true);
     private BlockState blockState;
     protected Level level;
     protected final BlockPos worldPosition;
@@ -180,6 +185,11 @@ public abstract class BlockEntity {

     public void setBlockState(BlockState blockState) {
         this.blockState = blockState;
+        // Aurora - prevent null state
+        if (this.blockState == null) {
+            LOGGER.error("BlockEntity has null blockState!");
+            this.blockState = Blocks.AIR.defaultBlockState();
+        }
     }

     @Nullable
