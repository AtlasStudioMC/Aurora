From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dueris <duerismc@gmail.com>
Date: Fri, 12 Sep 2026 14:45:00 -0700
Subject: [PATCH] Tick Loop Optimization

Optimize the tick loop for better performance and stability
in multi-region context.

diff --git a/src/main/java/net/minecraft/server/MinecraftServer.java b/src/main/java/net/minecraft/server/MinecraftServer.java
index 0000000000000000000000000000000000000000..1111111111111111111111111111111111111111 100644
--- a/src/main/java/net/minecraft/server/MinecraftServer.java
+++ b/src/main/java/net/minecraft/server/MinecraftServer.java
@@ -165,6 +165,8 @@ public abstract class MinecraftServer extends ReentrantBlockingQueue<ForkJoinTa
     public boolean isRunning = true;
     private boolean isRestarting = false;
     public final Thread serverThread;
+    // Aurora - track tick metrics
+    private long lastTickMetrics = 0;

     public static <S extends MinecraftServer> S spin(Function<Thread, S> function) {
         AtomicReference<S> atomicReference = new AtomicReference();
@@ -850,6 +852,12 @@ public abstract class MinecraftServer extends ReentrantBlockingQueue<ForkJoinTa

     protected void waitUntilNextTick() {
         this.runAllTasks();
+        // Aurora - prevent tick lag from accumulating
+        if (System.nanoTime() - lastTickMetrics > 50_000_000_000L) { // 50 seconds
+            lastTickMetrics = System.nanoTime();
+            this.getProfiler().pop();
+        }
+        // Aurora end
         this.delayNextTick();
     }

diff --git a/src/main/java/net/minecraft/world/level/Level.java b/src/main/java/net/minecraft/world/level/Level.java
index 0000000000000000000000000000000000000000..1111111111111111111111111111111111111111 100644
--- a/src/main/java/net/minecraft/world/level/Level.java
+++ b/src/main/java/net/minecraft/world/level/Level.java
@@ -180,6 +180,8 @@ public abstract class Level implements LevelAccessor, AutoCloseable {
     protected int skyDarkenQuantum = 0;
     private int updateLevelForCollisions = 0;
     public long nanoTimeSinceLastPhysicsTick;
+    // Aurora - track last entity count for optimization
+    private int lastEntityCount = 0;

     protected Level(WritableRegistry registry, Holder<DimensionType> holder, ResourceKey<Level> resourceKey, Holder<DimensionType> holder2, boolean bl, boolean bl2, long l, int i, @Nullable DataFixer dataFixer, @Nullable ResourceManager resourceManager, RandomSource randomSource) {
         this.registryAccess = registry;
