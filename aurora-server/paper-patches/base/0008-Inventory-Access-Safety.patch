From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dueris <duerismc@gmail.com>
Date: Fri, 12 Sep 2026 13:30:00 -0700
Subject: [PATCH] Inventory Access Safety

Add defensive checks for inventory operations to prevent crashes
when plugins access player inventories from async contexts.

diff --git a/src/main/java/net/minecraft/world/entity/player/Player.java b/src/main/java/net/minecraft/world/entity/player/Player.java
index 0000000000000000000000000000000000000000..1111111111111111111111111111111111111111 100644
--- a/src/main/java/net/minecraft/world/entity/player/Player.java
+++ b/src/main/java/net/minecraft/world/entity/player/Player.java
@@ -780,6 +785,11 @@ public abstract class Player extends LivingEntity {
     public void drop(ItemStack itemStack, boolean dropAll) {
         if (itemStack.isEmpty()) {
             return;
+        }
+        // Aurora - prevent crash from null inventory
+        if (this.containerMenu == null) {
+            return;
         }
+        // Aurora end

         ItemEntity itemEntity = new ItemEntity(this.level(), this.getX(), this.getEyeY() - 0.3, this.getZ(), itemStack);
         itemEntity.setPickUpDelay(40);
diff --git a/src/main/java/net/minecraft/world/inventory/PlayerEnderChestContainer.java b/src/main/java/net/minecraft/world/inventory/PlayerEnderChestContainer.java
index 0000000000000000000000000000000000000000..1111111111111111111111111111111111111111 100644
--- a/src/main/java/net/minecraft/world/inventory/PlayerEnderChestContainer.java
+++ b/src/main/java/net/minecraft/world/inventory/PlayerEnderChestContainer.java
@@ -52,6 +52,11 @@ public class PlayerEnderChestContainer extends SimpleContainer {
     @Override
     public ItemStack removeItemNoUpdate(int slot) {
         List<ItemStack> list = this.itemStacks;
+        // Aurora - thread safe access
+        if (list == null || slot < 0 || slot >= list.size()) {
+            return ItemStack.EMPTY;
+        }
+        // Aurora end
         return (ItemStack) list.set(slot, ItemStack.EMPTY);
     }

