From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dueris <duerismc@gmail.com>
Date: Fri, 12 Sep 2026 19:30:00 -0700
Subject: [PATCH] Player Data Optimization

Optimize player data loading and saving
to reduce I/O overhead.

diff --git a/src/main/java/net/minecraft/server/players/PlayerList.java b/src/main/java/net/minecraft/server/players/PlayerList.java
index 0000000000000000000000000000000000000000..1111111111111111111111111111111111111111 100644
--- a/src/main/java/net/minecraft/server/players/PlayerList.java
+++ b/src/main/java/net/minecraft/server/players/PlayerList.java
@@ -35,6 +35,9 @@ public abstract class PlayerList {
     private final GameRules gameRules;
     private final Predicate<String> bannedIps;
     private final Predicate<GameProfile> bannedPlayers;
+    // Aurora - optimize player data
+    private static final java.util.concurrent.ConcurrentHashMap<UUID, Long> playerSaveCache = new java.util.concurrent.ConcurrentHashMap<>();
+    private static final long SAVE_INTERVAL = 30_000; // 30 seconds

     public PlayerList(MinecraftServer minecraftserver, LayeredRegistryAccess layeredregistryaccess, PlayerDataStorage playerdatastorage, int i) {
         this.cserver = minecraftserver.server;
@@ -430,6 +433,12 @@ public abstract class PlayerList {

     public void save(ServerPlayer serverplayer) {
+        // Aurora - rate limit player saves
+        Long lastSave = playerSaveCache.get(serverplayer.getUUID());
+        if (lastSave != null && System.currentTimeMillis() - lastSave < SAVE_INTERVAL) {
+            return;
+        }
+        playerSaveCache.put(serverplayer.getUUID(), System.currentTimeMillis());
         if (serverplayer.connection == null) return; // CraftBukkit
         this.playerIo.save(serverplayer);
     }
