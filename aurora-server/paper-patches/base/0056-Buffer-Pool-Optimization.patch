Subject: [PATCH] Buffer Pool Optimization

Implement object pooling for network buffers
to reduce garbage collection pressure.

diff --git a/src/main/java/net/minecraft/network/Connection.java b/src/main/java/net/minecraft/network/Connection.java
index 4444444444444444444444444444444444444444..5555555555555555555555555555555555555555 100644
--- a/src/main/java/net/minecraft/network/Connection.java
+++ b/src/main/java/net/minecraft/network/Connection.java
@@ -130,6 +130,35 @@ public class Connection extends SimpleChannelInboundHandler<Packet<?>> {
         dynamicBatchSize = Math.min(128.0f, dynamicBatchSize * 1.02f);
         return true;
     }
+
+    // Aurora - buffer pool optimization
+    private static final java.util.concurrent.ConcurrentHashMap<Integer, java.util.Queue<io.netty.buffer.ByteBuf>> bufferPool =
+        new java.util.concurrent.ConcurrentHashMap<>();
+    private static final int POOL_SIZE = 256;
+    private static final int[] BUFFER_SIZES = {256, 512, 1024, 4096, 8192};
+
+    static {
+        for (int size : BUFFER_SIZES) {
+            java.util.Queue<io.netty.buffer.ByteBuf> queue = new java.util.concurrent.ConcurrentLinkedQueue<>();
+            for (int i = 0; i < POOL_SIZE / BUFFER_SIZES.length; i++) {
+                queue.offer(io.netty.buffer.Unpooled.directBuffer(size));
+            }
+            bufferPool.put(size, queue);
+        }
+    }
+
+    private static io.netty.buffer.ByteBuf acquireBuffer(int minCapacity) {
+        for (int size : BUFFER_SIZES) {
+            if (size >= minCapacity) {
+                java.util.Queue<io.netty.buffer.ByteBuf> queue = bufferPool.get(size);
+                io.netty.buffer.ByteBuf buf = queue.poll();
+                if (buf != null) return buf.clear();
+            }
+        }
+        return io.netty.buffer.Unpooled.directBuffer(minCapacity);
+    }

