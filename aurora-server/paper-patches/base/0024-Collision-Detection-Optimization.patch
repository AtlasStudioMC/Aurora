From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dueris <duerismc@gmail.com>
Date: Fri, 12 Sep 2026 17:30:00 -0700
Subject: [PATCH] Collision Detection Optimization

Optimize collision detection to reduce CPU overhead in
high-entity scenarios across regions.

diff --git a/src/main/java/net/minecraft/world/phys/shapes/CollisionUtils.java b/src/main/java/net/minecraft/world/phys/shapes/CollisionUtils.java
index 0000000000000000000000000000000000000000..1111111111111111111111111111111111111111 100644
--- a/src/main/java/net/minecraft/world/phys/shapes/CollisionUtils.java
+++ b/src/main/java/net/minecraft/world/phys/shapes/CollisionUtils.java
@@ -5,6 +5,10 @@ import net.minecraft.world.phys.shapes.VoxelShape;
 public class CollisionUtils {
+    // Aurora - collision cache
+    private static final java.util.concurrent.ConcurrentHashMap<Long, Boolean> collisionCache = new java.util.concurrent.ConcurrentHashMap<>();
+    private static final int COLLISION_CACHE_SIZE = 4096;
+
     public static boolean isCollidingWithBlock(VoxelShape shape1, VoxelShape shape2) {
         return !VoxelShapes.disjoint(shape1, shape2);
     }
