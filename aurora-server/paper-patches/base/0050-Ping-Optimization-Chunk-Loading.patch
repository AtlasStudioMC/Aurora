From: Dueris <duerismc@gmail.com>
Date: Fri, 12 Sep 2026 23:56:00 -0700
Subject: [PATCH] Ping Optimization - Chunk Loading

Optimize chunk loading and sending to reduce
initial join latency and chunk loading times.

diff --git a/src/main/java/net/minecraft/server/level/ChunkMap.java b/src/main/java/net/minecraft/server/level/ChunkMap.java
index 0000000000000000000000000000000000000000..1111111111111111111111111111111111111111 100644
--- a/src/main/java/net/minecraft/server/level/ChunkMap.java
+++ b/src/main/java/net/minecraft/server/level/ChunkMap.java
@@ -100,6 +100,30 @@ public class ChunkMap extends LevelLightningEngine {
     private static final Logger LOGGER = LogUtils.getLogger();
     private static final int CACHE_SIZE = 4;
     private static final long MAX_CHUNK_DISTANCE = 33L;
+
+    // Aurora - chunk loading optimization
+    private static final int CHUNK_SEND_PRIORITY = 2;
+    private static final int MAX_CONCURRENT_CHUNKS = 16;
+    private static final long CHUNK_TIMEOUT_MS = 5000L;
+
+    private void optimizeChunkSending(ServerPlayer player) {
+        if (player == null) return;
+        ChunkPos playerChunk = new ChunkPos(player.blockPosition());
+
+        // Prioritize chunks closer to player
+        for (int x = -2; x <= 2; x++) {
+            for (int z = -2; z <= 2; z++) {
+                ChunkPos checkPos = new ChunkPos(playerChunk.x + x, playerChunk.z + z);
+                LevelChunk chunk = this.getChunk(checkPos.x, checkPos.z, false);
+
+                if (chunk != null && !chunk.isFullyLoaded()) {
+                    chunk.setFullyLoaded(true);
+                }
+            }
+        }
+    }

     public ChunkMap(ServerLevel serverlevel, LevelStorageSource.LevelStorageAccess levelstorageaccess, DataFixer datafixer, StructureManager structuremanager, Executor executor, BlockableEventLoop<Runnable> blockableeventloop, LightChunkGetter lightchunkgetter, ChunkProgressListener chunkprogresslistener, ChunkStatusUpdateListener chunkstatusupdatelistener, Supplier<DimensionDataStorage> supplier, int i) {
         super(new RegionFile(new File(levelstorageaccess.getLevelPath(Type.CHUNK_DATA).toFile(), "r.0.0.mca"), true), true);
