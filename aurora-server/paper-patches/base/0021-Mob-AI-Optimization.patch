From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dueris <duerismc@gmail.com>
Date: Fri, 12 Sep 2026 16:45:00 -0700
Subject: [PATCH] Mob AI Optimization

Optimize mob AI and pathfinding for better performance in
multi-region context with concurrent AI updates.

diff --git a/src/main/java/net/minecraft/world/entity/ai/goal/GoalSelector.java b/src/main/java/net/minecraft/world/entity/ai/goal/GoalSelector.java
index 0000000000000000000000000000000000000000..1111111111111111111111111111111111111111 100644
--- a/src/main/java/net/minecraft/world/entity/ai/goal/GoalSelector.java
+++ b/src/main/java/net/minecraft/world/entity/ai/goal/GoalSelector.java
@@ -24,7 +24,8 @@ public class GoalSelector {
     private final EnumMap<Goal.Flag, WrappedGoal> availableGoals = new EnumMap(Goal.Flag.class);
     private final Set<WrappedGoal> goals = new java.util.concurrent.ConcurrentHashSet<>(); // Paper - use ConcurrentHashSet
     private static final Goal NULL_GOAL = new Goal() { // Paper - use lambdas
-        public boolean canUse() {
+        // Aurora - optimize null goal
+        public boolean canUse() {
             return false;
         }

@@ -50,6 +55,12 @@ public class GoalSelector {
     public void tick() {
         this.lockedFlags.clear();

+        // Aurora - prevent crashes from null mob
+        if (this.mob == null) {
+            LOGGER.warn("GoalSelector has null mob!");
+            return;
+        }
+        // Aurora end
+
         for (WrappedGoal wrappedgoal : this.goals) {
             if (!wrappedgoal.isRunning()) {
                 continue;
