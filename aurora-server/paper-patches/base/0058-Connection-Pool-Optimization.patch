Subject: [PATCH] Connection Pool Optimization

Implement connection pooling and reuse to reduce
connection establishment overhead.

diff --git a/src/main/java/net/minecraft/network/Connection.java b/src/main/java/net/minecraft/network/Connection.java
index 5555555555555555555555555555555555555555..6666666666666666666666666666666666666666 100644
--- a/src/main/java/net/minecraft/network/Connection.java
+++ b/src/main/java/net/minecraft/network/Connection.java
@@ -160,6 +160,32 @@ public class Connection extends SimpleChannelInboundHandler<Packet<?>> {
             return io.netty.buffer.Unpooled.directBuffer(minCapacity);
     }

+    // Aurora - connection pool
+    private static final java.util.concurrent.ConcurrentHashMap<String, java.util.Queue<Connection>> connectionPool =
+        new java.util.concurrent.ConcurrentHashMap<>();
+    private static final int MAX_POOLED_CONNECTIONS = 128;
+    private static final long CONNECTION_TIMEOUT = 30_000L;
+    private long connectionCreatedTime = System.currentTimeMillis();
+    private java.util.concurrent.atomic.AtomicLong lastActivityTime =
+        new java.util.concurrent.atomic.AtomicLong(System.currentTimeMillis());
+
+    private static void returnToPool(String key, Connection conn) {
+        java.util.Queue<Connection> queue = connectionPool.computeIfAbsent(key, k ->
+            new java.util.concurrent.ConcurrentLinkedQueue<>());
+
+        if (queue.size() < MAX_POOLED_CONNECTIONS) {
+            queue.offer(conn);
+        }
+    }
+
+    private static Connection borrowFromPool(String key) {
+        java.util.Queue<Connection> queue = connectionPool.get(key);
+        if (queue != null) {
+            Connection conn = queue.poll();
+            if (conn != null) return conn;
+        }
+        return null;
+    }

     private int getPacketPriority(Packet<?> packet) {
         return (packet instanceof ClientboundGameEventPacket) ? 10 :
