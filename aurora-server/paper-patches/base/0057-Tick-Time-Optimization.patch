From: Dueris <duerismc@gmail.com>
Date: Sat, 13 Sep 2026 00:03:00 -0700
Subject: [PATCH] Tick Time Optimization

Optimize server tick timing to maintain consistent
50ms ticks and reduce jitter.

diff --git a/src/main/java/net/minecraft/server/MinecraftServer.java b/src/main/java/net/minecraft/server/MinecraftServer.java
index 1111111111111111111111111111111111111111..5555555555555555555555555555555555555555 100644
--- a/src/main/java/net/minecraft/server/MinecraftServer.java
+++ b/src/main/java/net/minecraft/server/MinecraftServer.java
@@ -250,6 +250,32 @@ public abstract class MinecraftServer extends ReentrantBlockingQueue<ForkJoinTa
     private static final java.util.concurrent.ConcurrentHashMap<String, Long> lockTimestamps = new java.util.concurrent.ConcurrentHashMap<>();
     private static boolean debugLoggingEnabled = false;

+    // Aurora - tick time optimization
+    private static final long TARGET_TICK_TIME_NANOS = 50_000_000L; // 50ms
+    private static final int TICK_RATE = 20; // 20 TPS
+    private long tickStartTime;
+    private long totalTickTime = 0L;
+    private int tickCount = 0;
+    private static final java.util.concurrent.atomic.AtomicLong lastTickTime =
+        new java.util.concurrent.atomic.AtomicLong(System.nanoTime());
+    private static final java.util.concurrent.atomic.AtomicDouble avgTickTime =
+        new java.util.concurrent.atomic.AtomicDouble(0.0);
+
+    private void optimizeTick() {
+        tickStartTime = System.nanoTime();
+    }
+
+    private void completeTick() {
+        long tickEndTime = System.nanoTime();
+        long tickDuration = tickEndTime - tickStartTime;
+        totalTickTime += tickDuration;
+        tickCount++;
+
+        if (tickCount >= 100) {
+            avgTickTime.set((double)totalTickTime / tickCount / 1_000_000.0);
+            totalTickTime = 0;
+            tickCount = 0;
+        }
+    }

     public static <S extends MinecraftServer> S spin(Function<Thread, S> function) {
