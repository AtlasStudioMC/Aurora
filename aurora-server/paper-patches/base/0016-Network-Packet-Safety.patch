From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dueris <duerismc@gmail.com>
Date: Fri, 12 Sep 2026 15:30:00 -0700
Subject: [PATCH] Network Packet Safety

Add defensive checks in network packet handling to prevent
crashes from invalid packet states or concurrent access.

diff --git a/src/main/java/net/minecraft/network/protocol/game/ServerGamePacketListener.java b/src/main/java/net/minecraft/network/protocol/game/ServerGamePacketListener.java
index 0000000000000000000000000000000000000000..1111111111111111111111111111111111111111 100644
--- a/src/main/java/net/minecraft/network/protocol/game/ServerGamePacketListener.java
+++ b/src/main/java/net/minecraft/network/protocol/game/ServerGamePacketListener.java
@@ -280,6 +280,11 @@ public class ServerGamePacketListener implements ServerPlayerConnection, Tickab

     @Override
     public void handlePlayerInput(ServerboundPlayerInputPacket serverboundplayerinputpacket) {
+        // Aurora - safety check
+        if (this.player == null || this.player.isRemoved()) {
+            return;
+        }
+        // Aurora end
         PacketUtils.ensureRunningOnSameThread(serverboundplayerinputpacket, this, this.player.serverLevel());
         this.player.setPlayerInput(serverboundplayerinputpacket.getXxa(), serverboundplayerinputpacket.getZza(), serverboundplayerinputpacket.isJumping(), serverboundplayerinputpacket.isSneaking());
     }
@@ -287,6 +292,11 @@ public class ServerGamePacketListener implements ServerPlayerConnection, Tickab
     @Override
     public void handleMovePlayer(ServerboundMovePlayerPacket serverboundmoveplayerpacket) {
         PacketUtils.ensureRunningOnSameThread(serverboundmoveplayerpacket, this, this.player.serverLevel());
+        // Aurora - safety check
+        if (this.player == null || this.player.isRemoved() || this.player.containerMenu == null) {
+            return;
+        }
+        // Aurora end

         ServerLevel serverlevel = this.player.getLevel();
         double d0 = this.player.getX();
