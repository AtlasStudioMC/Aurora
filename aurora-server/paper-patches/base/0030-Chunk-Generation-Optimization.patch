From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dueris <duerismc@gmail.com>
Date: Fri, 12 Sep 2026 19:00:00 -0700
Subject: [PATCH] Chunk Generation Optimization

Optimize chunk generation pipeline to reduce
latency and improve generation performance.

diff --git a/src/main/java/net/minecraft/server/level/progress/ChunkProgressListener.java b/src/main/java/net/minecraft/server/level/progress/ChunkProgressListener.java
index 0000000000000000000000000000000000000000..1111111111111111111111111111111111111111 100644
--- a/src/main/java/net/minecraft/server/level/progress/ChunkProgressListener.java
+++ b/src/main/java/net/minecraft/server/level/progress/ChunkProgressListener.java
@@ -4,6 +4,12 @@ import net.minecraft.world.level.ChunkPos;

 public interface ChunkProgressListener {
+
+    // Aurora - optimize chunk generation tracking
+    static class ChunkGenCache {
+        static final java.util.concurrent.ConcurrentHashMap<Long, Boolean> cache = new java.util.concurrent.ConcurrentHashMap<>();
+        static final int MAX_SIZE = 4096;
+    }
+
     void onStatusChange(ChunkPos chunkPos, ChunkStatus chunkStatus);

     void start();
