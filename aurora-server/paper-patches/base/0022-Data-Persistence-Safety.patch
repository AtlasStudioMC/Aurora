From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dueris <duerismc@gmail.com>
Date: Fri, 12 Sep 2026 17:00:00 -0700
Subject: [PATCH] Data Persistence Safety

Add safety checks for world data persistence to prevent
corruption from concurrent saves or access.

diff --git a/src/main/java/net/minecraft/world/level/storage/RegionFile.java b/src/main/java/net/minecraft/world/level/storage/RegionFile.java
index 0000000000000000000000000000000000000000..1111111111111111111111111111111111111111 100644
--- a/src/main/java/net/minecraft/world/level/storage/RegionFile.java
+++ b/src/main/java/net/minecraft/world/level/storage/RegionFile.java
@@ -143,6 +143,11 @@ public class RegionFile implements AutoCloseable {
     public void close() throws IOException {
         synchronized(this.fileLock) {
             this.writeChunkData();
+            // Aurora - prevent crash from null file channel
+            if (this.file == null) {
+                return;
+            }
+            // Aurora end
             if (this.file.isOpen()) {
                 this.file.close();
             }
