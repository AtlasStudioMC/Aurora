From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dueris <duerismc@gmail.com>
Date: Fri, 12 Sep 2026 17:15:00 -0700
Subject: [PATCH] Fluid and Block Updates Optimization

Optimize fluid and block update propagation to reduce overhead
in multi-region context.

diff --git a/src/main/java/net/minecraft/world/level/block/state/BlockBehaviour.java b/src/main/java/net/minecraft/world/level/block/state/BlockBehaviour.java
index 0000000000000000000000000000000000000000..1111111111111111111111111111111111111111 100644
--- a/src/main/java/net/minecraft/world/level/block/state/BlockBehaviour.java
+++ b/src/main/java/net/minecraft/world/level/block/state/BlockBehaviour.java
@@ -180,6 +180,11 @@ public class BlockBehaviour {
     public void onPlace(BlockState blockstate, Level level, BlockPos blockpos, BlockState blockstate2, boolean bl) {
     }

+    // Aurora - cache block properties
+    private volatile int updateTimestamp = 0;
+    private volatile int lastUpdateCheck = 0;
+    private static final java.util.concurrent.ConcurrentHashMap<String, Boolean> UPDATE_CACHE = new java.util.concurrent.ConcurrentHashMap<>();
+
     public void neighborChanged(BlockState blockstate, Level level, BlockPos blockpos, Block block, BlockPos blockpos2, boolean bl) {
     }

