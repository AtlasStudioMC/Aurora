From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dueris <duerismc@gmail.com>
Date: Fri, 12 Sep 2026 13:45:00 -0700
Subject: [PATCH] Chunk Load Safety

Improve chunk loading safety to prevent crashes when plugins
force-load chunks from async contexts.

diff --git a/src/main/java/net/minecraft/world/level/Level.java b/src/main/java/net/minecraft/world/level/Level.java
index 0000000000000000000000000000000000000000..1111111111111111111111111111111111111111 100644
--- a/src/main/java/net/minecraft/world/level/Level.java
+++ b/src/main/java/net/minecraft/world/level/Level.java
@@ -900,6 +900,11 @@ public abstract class Level implements LevelAccessor, AutoCloseable {

     public final void unload(ChunkAccess chunk) {
         chunk.setUnsaved(false);
+        // Aurora - safety check
+        if (chunk == null) {
+            return;
+        }
+        // Aurora end
         this.chunkSource.chunkMap.scheduleUnload(chunk);
     }

diff --git a/src/main/java/net/minecraft/server/level/ServerLevel.java b/src/main/java/net/minecraft/server/level/ServerLevel.java
index 0000000000000000000000000000000000000000..1111111111111111111111111111111111111111 100644
--- a/src/main/java/net/minecraft/server/level/ServerLevel.java
+++ b/src/main/java/net/minecraft/server/level/ServerLevel.java
@@ -1500,6 +1500,13 @@ public class ServerLevel extends Level implements WorldGenLevel {

     public ChunkAccess getChunk(int x, int z, ChunkStatus leastStatus, boolean create) {
         ChunkAccess ichunkaccess;
+        // Aurora - prevent crash on null chunk status
+        if (leastStatus == null) {
+            LOGGER.error("Chunk status was null for chunk [" + x + ", " + z + "]");
+            leastStatus = ChunkStatus.FULL;
+        }
+        // Aurora end
+
         for (ichunkaccess = this.getChunkIfLoadedImmediately(x, z); ichunkaccess == null; ichunkaccess = this.chunkSource.getChunk(x, z, leastStatus, create)) {
             if (!create) {
                 break;
