From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dueris <duerismc@gmail.com>
Date: Fri, 12 Sep 2026 22:30:00 -0700
Subject: [PATCH] Graceful Shutdown

Ensure proper cleanup and graceful shutdown
to prevent data corruption and resource leaks.

diff --git a/src/main/java/net/minecraft/server/MinecraftServer.java b/src/main/java/net/minecraft/server/MinecraftServer.java
index 0000000000000000000000000000000000000000..1111111111111111111111111111111111111111 100
--- a/src/main/java/net/minecraft/server/MinecraftServer.java
+++ b/src/main/java/net/minecraft/server/MinecraftServer.java
@@ -1150,6 +1150,20 @@ public abstract class MinecraftServer extends ReentrantBlockingQueue<ForkJoinTa

     public void stopServer() {
+        // Aurora - graceful shutdown sequence
+        LOGGER.info("Aurora: Beginning graceful shutdown");
+        try {
+            // Save all player data
+            if (this.playerList != null) {
+                this.playerList.saveAll();
+            }
+            LOGGER.info("Aurora: Player data saved");
+        } catch (Exception ex) {
+            LOGGER.error("Aurora: Error during graceful shutdown", ex);
+        }
+        // Aurora end
+
         if (!this.serverRunning) {
             return;
         }
